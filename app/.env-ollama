# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Copy this file to app/.env to run the Docker stack against local Ollama.

DATABASE_URL="postgresql://climber:climber512@localhost:5432/climbapp"
SESSION_SECRET="super-secret-session-key-change-in-production-32chars!!"

# Local Ollama backend.
ANTHROPIC_API_KEY="ollama"
ANTHROPIC_BASE_URL="http://host.docker.internal:11434"
ANTHROPIC_MODEL="gemma4:e4b"
ANTHROPIC_MAX_TOKENS="5000"
AI_GUARDRAILS_MODE="off"
AI_GUARDRAILS_BASE_URL="http://guardrails:8000"
